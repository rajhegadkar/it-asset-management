{
  "openapi": "3.0.3",
  "info": {
    "title": "Enterprise IT Asset Management (ITAM) REST API",
    "description": "Production-ready, enterprise-grade IT Asset Management platform API supporting lifecycle tracking, hardware asset management, software licenses (SAM), spare consumables, integrated helpdesk, audit logs, and hardware label generation.",
    "version": "1.0.0",
    "contact": {
      "name": "IT Operations Engineering",
      "email": "it-support@acme-corp.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1",
      "description": "Local Development / Enterprise On-Premises Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": { "type": "object" },
          "pagination": {
            "type": "object",
            "properties": {
              "total": { "type": "integer" },
              "page": { "type": "integer" },
              "limit": { "type": "integer" },
              "totalPages": { "type": "integer" }
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string", "example": "Asset cannot be allocated because it is already assigned." },
          "code": { "type": "string", "example": "ASSET_ALREADY_ASSIGNED" },
          "errors": { "type": "array", "items": { "type": "object" } }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["emailOrUsername", "password"],
        "properties": {
          "emailOrUsername": { "type": "string", "example": "admin@acme-corp.com" },
          "password": { "type": "string", "example": "Admin@123456" },
          "totpCode": { "type": "string", "example": "123456" }
        }
      },
      "Asset": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "assetId": { "type": "string", "example": "IT-LAP-000001" },
          "assetTag": { "type": "string", "example": "TAG-DL-7440-001" },
          "serialNumber": { "type": "string", "example": "SN-DELL-7440-XY12" },
          "name": { "type": "string", "example": "Dell Latitude 7440 Ultrabook 14\"" },
          "status": { "type": "string", "example": "AVAILABLE" },
          "condition": { "type": "string", "example": "EXCELLENT" },
          "purchaseCost": { "type": "number", "example": 1899.0 },
          "cpu": { "type": "string", "example": "Intel Core i7-1365U vPro" },
          "ram": { "type": "string", "example": "32GB LPDDR5" },
          "storage": { "type": "string", "example": "1TB NVMe SSD" }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Check system health status",
        "security": [],
        "responses": {
          "200": { "description": "System is operational" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user with password and optional 2FA",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Authentication successful" },
          "401": { "description": "Invalid credentials or locked out" }
        }
      }
    },
    "/assets": {
      "get": {
        "summary": "List IT assets with server-side pagination and filters",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "categoryId", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Assets list returned" }
        }
      },
      "post": {
        "summary": "Create new IT asset and generate unique tag/barcode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Asset" }
            }
          }
        },
        "responses": {
          "201": { "description": "Asset created successfully" }
        }
      }
    },
    "/assets/dashboard-metrics": {
      "get": {
        "summary": "Retrieve aggregated IT dashboard KPIs and analytics metrics",
        "responses": {
          "200": { "description": "Dashboard metrics object" }
        }
      }
    },
    "/allocations/allocate": {
      "post": {
        "summary": "Allocate asset to employee and generate handover document",
        "responses": {
          "201": { "description": "Asset successfully allocated" },
          "400": { "description": "Asset unavailable or already assigned" }
        }
      }
    },
    "/allocations/return": {
      "post": {
        "summary": "Process asset return, inspect condition and missing accessories",
        "responses": {
          "200": { "description": "Asset returned and stock restored" }
        }
      }
    },
    "/tickets": {
      "get": {
        "summary": "List helpdesk support tickets",
        "responses": { "200": { "description": "Tickets list" } }
      },
      "post": {
        "summary": "Create new IT support ticket with SLA assignment",
        "responses": { "201": { "description": "Ticket raised" } }
      }
    },
    "/licenses": {
      "get": {
        "summary": "List Software Asset Management (SAM) licenses and seat quotas",
        "responses": { "200": { "description": "Licenses list" } }
      }
    },
    "/consumables": {
      "get": {
        "summary": "List spare parts and consumables with low stock warnings",
        "responses": { "200": { "description": "Consumables inventory" } }
      }
    }
  }
}
