# Enterprise IT Asset Management (ITAM) - Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database: SQLite for local embedded dev, or PostgreSQL for production
# SQLite (default for instant zero-config setup):
DATABASE_URL="file:./dev.db"

# PostgreSQL (recommended for production):
# DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/itam_db?schema=public"

# Authentication Security (Generate 64+ char random keys for production)
JWT_SECRET="itam_jwt_secret_key_change_in_production_2026_xyz"
JWT_EXPIRES_IN="1h"   # short-lived; the web app refreshes it silently
JWT_REFRESH_SECRET="itam_jwt_refresh_secret_key_change_in_production_2026_xyz"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption keys (REQUIRED in production; generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SETTINGS_ENCRYPTION_KEY encrypts the SMTP password, cloud backup credentials and license keys in the DB.
# BACKUP_ENCRYPTION_KEY encrypts and signs backup archives. Keep a copy OFF this server:
# without it, backups cannot be restored.
SETTINGS_ENCRYPTION_KEY=""
BACKUP_ENCRYPTION_KEY=""

# Set to 1 when running behind nginx / a load balancer (so client IPs are correct)
# TRUST_PROXY=1
# Set to false on all but one server if you run more than one instance
# SCHEDULER_ENABLED=true
# Only if your mail server uses a self-signed certificate (not recommended)
# SMTP_ALLOW_SELF_SIGNED=false


# URLs & CORS Origins
APP_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173,http://localhost:5000,http://localhost:3000"

# Local Storage Directory
STORAGE_TYPE=local
UPLOAD_DIR="./uploads"

# SMTP Mail Settings (Google Workspace / Office 365 / SendGrid / Custom SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="IT Asset Management <noreply@itam-system.local>"

# Company Defaults
DEFAULT_COMPANY_NAME="Acme Global Technologies Inc."
DEFAULT_CURRENCY="USD"
