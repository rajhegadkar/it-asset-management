# Enterprise IT Asset Management (ITAM) Environment Variables
PORT=5000
NODE_ENV=production

# Database: SQLite for local/embedded or PostgreSQL for production
# SQLite: file:./dev.db
# PostgreSQL: postgresql://postgres:postgres_secure_password@postgres:5432/itam_db?schema=public
DATABASE_URL="postgresql://postgres:postgres_secure_password@postgres:5432/itam_db?schema=public"

# Authentication Security Secrets (Replace with randomly generated 64+ char keys)
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_GENERATE_WITH_OPENSSL_RAND_HEX_64"
JWT_EXPIRES_IN="1h"   # short-lived; the web app refreshes it silently
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_REFRESH_SECRET_KEY_64"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption keys (REQUIRED in production; generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SETTINGS_ENCRYPTION_KEY encrypts the SMTP password, cloud backup credentials and license keys in the DB.
# BACKUP_ENCRYPTION_KEY encrypts and signs backup archives. Keep a copy OFF this server:
# without it, backups cannot be restored.
SETTINGS_ENCRYPTION_KEY=""
BACKUP_ENCRYPTION_KEY=""

# Set to 1 when running behind nginx / a load balancer (so client IPs are correct)
# TRUST_PROXY=1
# Set to false on all but one server if you run more than one instance
# SCHEDULER_ENABLED=true
# Only if your mail server uses a self-signed certificate (not recommended)
# SMTP_ALLOW_SELF_SIGNED=false


# App & CORS Configuration
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# File Storage Configuration (local or s3)
STORAGE_TYPE="local"
UPLOAD_DIR="./uploads"

# AWS / S3 Compatible Storage (When STORAGE_TYPE=s3)
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_REGION="us-east-1"
# S3_BUCKET="itam-assets-production"
# S3_ACCESS_KEY="YOUR_AWS_ACCESS_KEY"
# S3_SECRET_KEY="YOUR_AWS_SECRET_KEY"

# SMTP Email Configuration
SMTP_HOST="smtp.company.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@company.com"
SMTP_PASS="SUPER_SECURE_PASSWORD"
SMTP_FROM="IT Asset Management <notifications@company.com>"

# Default Branding & Settings
DEFAULT_COMPANY_NAME="Acme Global Technologies Inc."
DEFAULT_CURRENCY="USD"
